<?xml version="1.0" encoding="UTF-8"?>
<!--
  Registers Arch Linux packages as a separate file type.
  Installed to: /usr/share/mime/packages/arch-swift.xml
  Run update-mime-database after installation.
-->
<mime-info xmlns="http://www.freedesktop.org/standards/shared-mime-info">
  <mime-type type="application/x-arch-swift-package">
    <comment>Arch Linux package</comment>
    <comment xml:lang="de">Arch-Linux-Paket</comment>
    <comment xml:lang="ru">Пакет Arch Linux</comment>

    <!-- Icon from the hicolor theme: assets/icons/arch-swift-package-icon.svg -->
    <icon name="arch-swift-package-icon"/>
    <generic-icon name="arch-swift-package-icon"/>

    <!--
      Precise glob patterns with a high weight must win over the generic
      application/x-compressed-tar, so the file does not open in an archiver.
    -->
    <glob pattern="*.pkg.tar.zst" weight="90"/>
    <glob pattern="*.pkg.tar.xz" weight="90"/>
    <glob pattern="*.pkg.tar.gz" weight="90"/>
    <glob pattern="*.pkg.tar" weight="90"/>

    <!-- Keep compatibility with archivers and file managers. -->
    <sub-class-of type="application/x-compressed-tar"/>
    <alias type="application/x-arch-package"/>
  </mime-type>
</mime-info>
