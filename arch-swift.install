# Скриптлеты pacman для ArchSwift.
#
# Pacman выполняет эти функции из корня системы (cwd = /), поэтому пути
# намеренно указаны относительными, как принято в пакетах Arch Linux.
# Все вызовы необязательных утилит защищены проверками: отсутствие утилиты
# не должно прерывать транзакцию pacman.

_update_mime_database() {
  if command -v update-mime-database >/dev/null 2>&1; then
    update-mime-database usr/share/mime >/dev/null 2>&1 || true
  fi
}

_update_desktop_database() {
  if command -v update-desktop-database >/dev/null 2>&1; then
    update-desktop-database -q usr/share/applications >/dev/null 2>&1 || true
  fi
}

_update_icon_cache() {
  if command -v gtk-update-icon-cache >/dev/null 2>&1; then
    gtk-update-icon-cache -q -t -f usr/share/icons/hicolor >/dev/null 2>&1 || true
  elif command -v gtk4-update-icon-cache >/dev/null 2>&1; then
    gtk4-update-icon-cache -q -t -f usr/share/icons/hicolor >/dev/null 2>&1 || true
  fi
}

post_install() {
  _update_mime_database
  _update_desktop_database
  _update_icon_cache

  cat <<'EOF'
ArchSwift установлен.

Теперь файлы *.pkg.tar.zst открываются мастером двойным щелчком.
Если ассоциация ещё не применилась в текущем сеансе, выполните:

  xdg-mime default arch-swift.desktop application/x-arch-swift-package
  update-desktop-database ~/.local/share/applications 2>/dev/null || true
EOF
}

post_upgrade() {
  _update_mime_database
  _update_desktop_database
  _update_icon_cache
}

post_remove() {
  _update_mime_database
  _update_desktop_database
  _update_icon_cache
}
