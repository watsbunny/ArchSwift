<?xml version="1.0" encoding="UTF-8"?>
<!--
  Icons are embedded into the binary as a GResource. That way the wizard looks
  the same after installing the package and when running straight from
  target/release, while the hicolor theme does not contain our icons yet.
-->
<gresources>
  <gresource prefix="/org/openarch/swift/icons">
    <file alias="scalable/apps/arch-swift-installer.svg">icons/arch-swift-installer.svg</file>
    <file alias="scalable/apps/arch-swift-package-icon.svg">icons/arch-swift-package-icon.svg</file>
  </gresource>
</gresources>
